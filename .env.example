# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys.
#
# Variables starting with NEXT_PUBLIC_ are sent to the browser. Only put
# values there that are safe for anyone to see.

# --- Supabase (Phase 2) — Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" / anon key. Safe in the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Bypasses Row Level Security — never expose it.
SUPABASE_SECRET_KEY=

# --- Anthropic (Phase 3) — console.anthropic.com → API Keys ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
